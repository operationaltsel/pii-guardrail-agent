.env

# local dev launch config (Claude Code browser preview) — machine-specific paths
.claude/

# adk web/run local session database (runtime state, not source)
.adk/

# mock backend's SQLite file (agent/agents/cs_agent/db.py) — runtime data, not source
agent/data/
*.db

__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# Heavy, fully-reproducible training intermediates — see README "Reproduksi model" to
# regenerate (fixed seed => same result). NOT ignored: ner_service/model/ (the model the
# service actually serves), ner_training/reports/ and benchmark/results/ (evidence for the
# accuracy/performance sections of the docs) — these ARE committed so the repo runs as-is.
ner_training/pretrained/
ner_training/models/
ner_training/data/generated/

# onnxruntime shape-inference / quantization leaves temp external-data files in cwd
# on failure (see export_onnx.py's fallback path) — never useful, sometimes huge
sym_shape_infer_temp.onnx
*.data

# Presentation-deck build pipeline (screenshots, headless browser profile, PPTX/DOCX
# exports) — working files for the take-home presentation, not app source.
artifact-work/
deliverables/
