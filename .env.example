# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- Agent ---
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
NER_SERVICE_URL=http://localhost:8001
NER_TIMEOUT_S=3.0
# NER_THRESHOLD=          # override the model's tuned default (0.0-1.0)
# NER_API_KEY=            # if the NER service requires X-API-Key
PII_REDACTION_MODE=pseudonymize   # pseudonymize ([REDACT_NAMA_1], reversible) | mask ([REDACT_NAMA], per the brief)
PII_FAIL_MODE=closed              # closed (refuse if NER is down, safe default) | open (degrade to regex-only)
PII_RESTORE_OUTPUT=true

# --- NER service ---
NER_MODEL_DIR=./model
NER_THREADS=2
